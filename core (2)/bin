**`drug_list.html`:**
```html
{% extends 'base.html' %}

{% block content %}
<h1 class="text-2xl font-bold mb-4">Drugs</h1>
<a href="{% url 'drug_create' %}" class="bg-blue-600 text-white p-2 rounded mb-4 inline-block">Add Drug</a>
<table class="w-full border-collapse border">
    <thead>
        <tr class="bg-gray-200">
            <th class="border p-2">Name</th>
            <th class="border p-2">Generic Name</th>
            <th class="border p-2">Price</th>
            <th class="border p-2">Controlled</th>
            <th class="border p-2">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for drug in drugs %}
        <tr>
            <td class="border p-2">{{ drug.name }}</td>
            <td class="border p-2">{{ drug.generic_name }}</td>
            <td class="border p-2">{{ drug.price }}</td>
            <td class="border p-2">{{ drug.is_controlled|yesno:"Yes,No" }}</td>
            <td class="border p-2">
                <a href="{% url 'drug_update' drug.pk %}" class="text-blue-600">Edit</a> |
                <a href="{% url 'drug_delete' drug.pk %}" class="text-red-600">Delete</a>
            </td>
        </tr>
        {% empty %}
        <tr>
            <td colspan="5" class="border p-2 text-center">No drugs found.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
```

